{
    "extends": "@tsconfig/svelte/tsconfig.json",
    "compilerOptions": {
        "target": "ESNext",
        "useDefineForClassFields": true,
        "module": "ESNext",
        "resolveJsonModule": true,
        "allowJs": true,
        "checkJs": true,
        "isolatedModules": true,
        "moduleDetection": "force"
    },
    "include": ["resources/js/**/*.ts", "resources/js/**/*.svelte", "resources/themes/**/*.ts", "resources/themes/**/*.svelte"]
}
